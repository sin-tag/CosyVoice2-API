# App
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./storage/voice_fast.db

# Auth
API_KEY=change-me-in-production

# IP Whitelist — comma-separated (empty = allow all)
ALLOWED_IPS=192.168.1.100

# Storage
VOICES_STORAGE_PATH=./storage/voices
HISTORY_STORAGE_PATH=./storage/history

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# MOSS-TTS Engine
MOSS_ENABLED=true
MOSS_MODEL_PATH=OpenMOSS-Team/MOSS-TTS-Realtime
MOSS_CODEC_PATH=OpenMOSS-Team/MOSS-Audio-Tokenizer
MOSS_DEVICE=cuda:0
MOSS_DTYPE=bfloat16

# Qwen3-TTS Engine
QWEN_ENABLED=true
QWEN_MODEL_PATH=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN_DEVICE=cuda:1
QWEN_DTYPE=bfloat16

# Performance
MAX_CONCURRENT_GENERATIONS=2
GENERATION_TIMEOUT_SEC=120
MAX_TEXT_LENGTH=5000
MAX_CONCURRENT_REQUESTS=50
