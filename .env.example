# App
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8010

# Database
DATABASE_URL=sqlite+aiosqlite:///./storage/voice_fast.db

# Auth
API_KEY=change-me-in-production

# IP Whitelist — comma-separated (empty = allow all)
ALLOWED_IPS=192.168.1.100

# Storage
VOICES_STORAGE_PATH=./storage/voices
HISTORY_STORAGE_PATH=./storage/history

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Qwen3-TTS-1.7B-CustomVoice (speaker+instruct+clone, multi-GPU: cuda:0,cuda:1)
QWEN_ENABLED=true
QWEN_MODEL_PATH=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN_DEVICE=cuda:0
QWEN_DTYPE=bfloat16

# Performance
MAX_CONCURRENT_GENERATIONS=2
GENERATION_TIMEOUT_SEC=120
MAX_TEXT_LENGTH=5000
MAX_CONCURRENT_REQUESTS=50
MAX_QUEUE_SIZE=100
